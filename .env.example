# --- Supabase (accounts + cloud sync) ---------------------------------------
# Project Settings > API. Leave blank to run in local-only mode (no accounts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SECRET_KEY=

# --- Stripe (subscriptions) -------------------------------------------------
STRIPE_SECRET_KEY=
# The recurring monthly Price for the membership (price_...)
STRIPE_PRICE_ID=
# From the webhook endpoint pointing at /api/billing/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Free trial length for a member's first subscription
STRIPE_TRIAL_DAYS=7

# --- App --------------------------------------------------------------------
# Public URL, used for Stripe return links (e.g. https://mehealth.app)
NEXT_PUBLIC_SITE_URL=
# Shown on the paywall after the free week, e.g. "$19.99/month"
NEXT_PUBLIC_PRICE_LABEL=
# Set to "false" to let signed-in members in without paying (testing only)
NEXT_PUBLIC_PAYWALL_ENABLED=true
